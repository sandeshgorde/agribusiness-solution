digraph G { rankdir=TB; bgcolor="white"; nodesep=0.3; ranksep=0.5;
node [shape=plaintext, fontname="Helvetica", fontsize=11];
edge [color="#555555", fontname="Helvetica", fontsize=8.5, arrowhead=crow, arrowtail=none];
users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>users</b></font></td></tr><tr><td align="left">id PK (bigint)<br align="left"/>role (enum)<br align="left"/>name, phone UNIQUE<br align="left"/>password_hash<br align="left"/>verified (bool)<br align="left"/></td></tr></table>>];
farm [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>farm</b></font></td></tr><tr><td align="left">id PK<br align="left"/>owner_id FK users<br align="left"/>village, district<br align="left"/>area_acres numeric(6,2)<br align="left"/></td></tr></table>>];
crop [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>crop</b></font></td></tr><tr><td align="left">id PK<br align="left"/>farm_id FK<br align="left"/>commodity, season<br align="left"/>expected_qty_kg<br align="left"/>harvest_date<br align="left"/></td></tr></table>>];
lot [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>produce_lot</b></font></td></tr><tr><td align="left">id PK<br align="left"/>crop_id FK<br align="left"/>grade (A/B/C)<br align="left"/>total_qty_kg, available_qty_kg<br align="left"/>CHECK available &gt;= 0<br align="left"/>version (optimistic lock)<br align="left"/></td></tr></table>>];
req [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>buyer_requirement</b></font></td></tr><tr><td align="left">id PK<br align="left"/>buyer_id FK users<br align="left"/>commodity, grade<br align="left"/>qty_kg, deliver_by, city<br align="left"/>status<br align="left"/></td></tr></table>>];
offer [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>offer</b></font></td></tr><tr><td align="left">id PK<br align="left"/>requirement_id FK<br align="left"/>lot_id FK<br align="left"/>qty_kg, price_per_kg<br align="left"/>valid_until, status<br align="left"/></td></tr></table>>];
ord [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>orders</b></font></td></tr><tr><td align="left">id PK<br align="left"/>offer_id FK UNIQUE<br align="left"/>total_amount numeric(12,2)<br align="left"/>status (enum)<br align="left"/></td></tr></table>>];
ship [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eaf4ec"><tr><td bgcolor="#2f5d3a"><font color="white"><b>shipment</b></font></td></tr><tr><td align="left">id PK<br align="left"/>order_id FK<br align="left"/>transporter_id FK users<br align="left"/>pickup, drop, status<br align="left"/></td></tr></table>>];
audit [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fff4d6"><tr><td bgcolor="#a07800"><font color="white"><b>audit_log</b></font></td></tr><tr><td align="left">id PK, actor_id<br align="left"/>action, entity, entity_id<br align="left"/>old/new JSON, created_at<br align="left"/></td></tr></table>>];
{rank=same; users; farm; crop}
{rank=same; lot; offer; req}
{rank=same; ord; ship; audit}
users -> farm [label="1..*"]; farm -> crop [label="1..*"]; crop -> lot [label="1..*"]; users -> req [label="1..*"]; req -> offer [label="1..*"]; lot -> offer [label="1..*"]; offer -> ord [label="1..1"]; ord -> ship [label="1..*"]; users -> audit [label="1..*", style=dashed];
}
